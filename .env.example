# ==============================================================================
# SHARED / REUSABLE VARIABLES
# ==============================================================================

# --- Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=8001
DOCS_PORT=8002
POSTGRES_PORT_EXTERNAL=54330

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=waifuapi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- URLs ---
API_BASE_URL=https://api.example.com
FRONTEND_URL=https://example.com
DOCS_URL=https://docs.example.com
STATUS_URL=https://example.com

# --- App Identity ---
APP_NAME=Waifu API
APP_TAGLINE="The API for your Waifu content. Access thousands of categorized anime illustrations via our robust REST API or browse freely."
GITHUB_URL=https://github.com/your-org/your-repo
CONTACT_EMAIL=support@example.com

# --- Discord (OAuth2, used by the backend) ---
# Credentials of your Discord application: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
# Must exactly match the frontend's VITE_DISCORD_REDIRECT_URI and be registered
# as an OAuth2 redirect URI in the Discord developer portal.
# For local development use: http://localhost:5173/auth/callback
DISCORD_REDIRECT_URI=https://example.com/auth/callback
DISCORD_SERVER_URL=https://discord.gg/your-invite

# --- Docs ---
DOCS_BASE_URL=/
DOCS_ORG_NAME=your-org
DOCS_PROJECT_NAME=your-repo

# ==============================================================================
# FRONTEND CONFIGURATION (Vite)
# ==============================================================================
# Vite only exposes variables prefixed with VITE_ to the browser. It loads this
# .env file directly (envDir is set to the repo root), so the values below are
# used both for local development (npm run dev/build) and via docker-compose.
VITE_DISCORD_CLIENT_ID=your-discord-client-id
# Must match DISCORD_REDIRECT_URI above. For local development use:
# http://localhost:5173/auth/callback
VITE_DISCORD_REDIRECT_URI=https://example.com/auth/callback
VITE_APP_TITLE=Waifu API
VITE_DOCS_URL=https://docs.example.com
VITE_CONTACT_EMAIL=support@example.com
VITE_DISCORD_SERVER_URL=https://discord.gg/your-invite
VITE_STATUS_URL=https://example.com
VITE_GITHUB_URL=https://github.com/your-org/your-repo
# Optional: Terms of Service page URL (the link is hidden while this is empty)
VITE_TOS_URL=

# --- Frontend image resizing (e.g. Cloudflare Image Resizing) ---
# Off by default; the original full-res image is served everywhere until enabled.
# Enabling requires IMG_TRANSFORM_PATH (it has no default).
IMG_TRANSFORM_ENABLED=false
# Prefix inserted after the CDN origin. For Cloudflare fold extra options here (trailing comma optional):
#   /cdn-cgi/image/format=auto             keeps GIF/WebP animating in thumbnails (resized only)
#   /cdn-cgi/image/format=auto,anim=false  freezes thumbnails to a static first frame (lighter)
# The image detail page always serves the untransformed original image, so animations play in full there.
IMG_TRANSFORM_PATH=
IMG_WIDTH_PARAM=width
IMG_CARD_WIDTH=640
IMG_PREVIEW_WIDTH=1280

# ==============================================================================
# BACKEND CONFIGURATION (.NET format)
# ==============================================================================
API_BASE_PATH=/

Logging__LogLevel__Default=Error
Logging__LogLevel__Microsoft=Error
Logging__LogLevel__Microsoft.Hosting.Lifetime=Information

Jwt__Key=change-me-to-a-long-random-string
Jwt__Issuer=waifu-api
Jwt__Audience=waifu-api-users

S3__AccessKey=your-s3-access-key
S3__SecretKey=your-s3-secret-key
S3__ServiceUrl=https://example.com
S3__Region=auto
S3__BucketName=your-bucket
S3__ForcePathStyle=true

Cdn__BaseUrl=https://cdn.example.com

# Optional: purge a single image's CDN cache (original + resized variants) on delete/update.
# Leave blank to disable purging. Token needs the Zone > Cache Purge permission.
Cloudflare__ZoneId=
Cloudflare__ApiToken=

Review__RequireImageReview=true
Review__RequireArtistReview=true
Review__RequireTagReview=true
# Whether proposed edits to existing content must be approved by a moderator.
Review__RequireEditRequestReview=true

# Minimum role that bypasses review when CREATING/uploading content (auto-accepted). "None" disables bypass.
Review__ImageReviewBypassMinRole=TrustedUser
Review__TagReviewBypassMinRole=TrustedUser
Review__ArtistReviewBypassMinRole=TrustedUser

# Minimum role that bypasses review for EDIT REQUESTS (auto-applied). Independent from the upload bypass
# above, so you can e.g. let trusted users edit freely while still reviewing their uploads. "None" disables.
Review__ImageEditReviewBypassMinRole=TrustedUser
Review__TagEditReviewBypassMinRole=TrustedUser
Review__ArtistEditReviewBypassMinRole=TrustedUser

Permissions__TagCreationMinRole=User
Permissions__ArtistCreationMinRole=User
Permissions__ImageUploadMinRole=User
Permissions__SubmitEditMinRole=User
# Minimum role allowed to edit the site banner (enforced by the API). Defaults to Moderator if unset/invalid.
Permissions__BannerManagementMinRole=Moderator

Image__MinWidth=800
Image__MinHeight=1000
Image__MaxWidth=9000
Image__MaxHeight=9000
Image__AnimatedMinWidth=400
Image__AnimatedMinHeight=200
Image__AnimatedMaxWidth=2000
Image__AnimatedMaxHeight=2000

Image__MaxUploadSizeMb=10
Image__DefaultPageSize=1
Image__MaxPageSize=-1
Tag__DefaultPageSize=30
Tag__MaxPageSize=-1
Artist__DefaultPageSize=30
Artist__MaxPageSize=-1
Album__DefaultPageSize=30
Album__MaxPageSize=-1
User__DefaultPageSize=30
User__MaxPageSize=-1
Report__DefaultPageSize=30
Report__MaxPageSize=-1
# Review queue pagination.
Review__DefaultPageSize=30
Review__MaxPageSize=-1
# Max simultaneously-open (pending) edits per user. 0 = unlimited.
Review__MaxOpenEditsPerUser=20
# Resolved review tasks older than this (days) are auto-pruned. 0 = keep forever.
Review__TaskRetentionDays=90

StorageDiff__DefaultPageSize=30
StorageDiff__MaxPageSize=100
